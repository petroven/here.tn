PORT=5000
NODE_ENV=development
PAYMENT_MODE=sandbox
JWT_SECRET=change_me_generate_a_long_random_string
COMMISSION_RATE=0.05
MIN_WITHDRAWAL_AMOUNT=50
# SQLite par défaut (rien à faire). Pour PostgreSQL en production, remplacer
# par une vraie chaîne : DATABASE_URL=postgres://user:pass@host:5432/dbname
# (DATABASE_SSL=false si l'hôte Postgres n'a pas de certificat TLS géré).
DATABASE_URL=sqlite://./data/marketplace.db

# URLs — le client Vite tourne sur 5174 (voir client/vite.config.js, strictPort).
# Utilisées pour les redirections OAuth, reset mot de passe, retour paiement.
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# OAuth — vide tant que les apps Google/Facebook ne sont pas créées
# (voir le guide publié précédemment pour les étapes exactes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMTP — sans ça, les emails (confirmation commande, bienvenue vendeur,
# garantie, reset mot de passe) échouent silencieusement (erreur 530).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=here.tn <noreply@here.tn>

# Paiement Konnect — vide = mode sandbox/mock automatique.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_WEBHOOK_SECRET=

# Paiement Flouci — vide = mode sandbox/mock automatique.
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
FLOUCI_WEBHOOK_SECRET=

# Stockage images — vide = fallback disque local (server/uploads),
# ne survit pas à un redéploiement sur la plupart des hébergeurs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS — "mock" journalise juste dans la console, aucun SMS réel envoyé.
SMS_PROVIDER=mock
WINSMS_API_KEY=
WINSMS_SENDER=here.tn
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Business — valeurs par défaut déjà raisonnables, à ajuster si besoin.
FREE_SHIPPING_THRESHOLD=0
SHIPPING_CHARGE_PER_STORE=true
COURIER_SEARCH_RADIUS_KM=10
COURIER_NOTIFICATION_TIMEOUT_SECONDS=60
WALLET_CASHBACK_RATE=0.01

# Compte bancaire de la plateforme — affiché au client qui choisit "virement
# bancaire" au paiement. Vide = l'option virement reste masquée côté client.
PLATFORM_BANK_TITULAIRE=
PLATFORM_BANK_RIB=
PLATFORM_BANK_NAME=
