// BuyHere — schéma de base de données (PostgreSQL)
//
// Conventions :
// - Les montants sont stockés en MILLIMES (entier) : 1 DT = 1000 millimes.
//   49,900 DT => 49900. Évite toute erreur d'arrondi des flottants.
// - Les tables sont nommées en snake_case pluriel (@@map), les modèles en PascalCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum Language {
  fr
  ar
}

enum OrderStatus {
  PENDING // En attente
  CONFIRMED // Confirmée
  SHIPPED // Expédiée
  DELIVERED // Livrée
  CANCELLED // Annulée
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  KONNECT
  FLOUCI
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT // valeur = pourcentage (ex. 10 => -10 %)
  FIXED // valeur = montant en millimes
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
}

// ─────────────────────────────── Utilisateurs ───────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique // format +216XXXXXXXX
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  role         Role     @default(CUSTOMER)
  language     Language @default(fr)
  pushToken    String? // Expo push token
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

/// Refresh tokens (rotation) : seul le hash SHA-256 est stocké.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Code à 6 chiffres envoyé par email/SMS pour réinitialiser le mot de passe.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("Maison") // Maison, Travail...
  fullName    String
  phone       String
  governorate String // l'un des 24 gouvernorats
  city        String
  street      String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── Catalogue ───────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameFr    String
  nameAr    String
  imageUrl  String?
  icon      String? // nom d'icône Lucide (ex. "shirt")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  categoryId    String
  nameFr        String
  nameAr        String
  descriptionFr String    @db.Text
  descriptionAr String    @db.Text
  price         Int // millimes
  compareAt     Int? // prix barré (millimes) => produit en promo si > price
  stock         Int       @default(0)
  brand         String?
  isFeatured    Boolean   @default(false) // "Populaires"
  isActive      Boolean   @default(true)
  flashEndsAt   DateTime? // offre flash active tant que > now()
  ratingAvg     Float     @default(0) // dénormalisé, recalculé à chaque avis
  ratingCount   Int       @default(0)
  soldCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([price])
  @@index([createdAt])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String? // identifiant Cloudinary (pour suppression)
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Variante = combinaison taille/couleur avec son propre stock et éventuel surcoût.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  size       String?
  color      String?
  colorHex   String? // pour afficher une pastille de couleur
  priceDelta Int     @default(0) // millimes ajoutés au prix de base
  stock      Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────── Panier ───────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique
  couponCode String?
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Une même ligne par (produit, variante). PostgreSQL traite NULL comme distinct :
  // l'unicité pour variantId NULL est garantie côté service.
  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

// ─────────────────────────────── Commandes ───────────────────────────────

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // BH-20260923-4F7K
  userId         String
  addressId      String?
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentRef     String? // identifiant Konnect / Flouci
  subtotal       Int // millimes
  discount       Int           @default(0)
  shippingFee    Int
  total          Int
  couponCode     String?
  // Copie figée de l'adresse : la commande reste lisible même si l'adresse est modifiée.
  shippingName   String
  shippingPhone  String
  shippingGov    String
  shippingCity   String
  shippingStreet String
  note           String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User                 @relation(fields: [userId], references: [id])
  address Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  // Instantané du produit au moment de l'achat
  name      String
  imageUrl  String?
  size      String?
  color     String?
  unitPrice Int // millimes
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// Historique des statuts : alimente la timeline de suivi dans l'app.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────── Engagement ───────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int // 1..5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // un avis par client et par produit
  @@index([productId])
  @@map("reviews")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique // en majuscules
  type        CouponType
  value       Int
  minSubtotal Int        @default(0) // millimes
  maxDiscount Int? // plafond pour les coupons en %
  usageLimit  Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json? // ex. { "orderId": "..." } pour la navigation
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Bannières du carrousel de l'accueil.
model Banner {
  id         String  @id @default(cuid())
  titleFr    String
  titleAr    String
  subtitleFr String?
  subtitleAr String?
  imageUrl   String
  // Cible au clic : "category:<slug>" ou "product:<slug>"
  target     String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  @@map("banners")
}
