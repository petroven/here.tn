# ─── Serveur ───
NODE_ENV=development
PORT=4000
# Origines autorisées (CORS), séparées par des virgules. "*" en développement.
CORS_ORIGINS=*

# ─── Base de données MySQL ───
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE
DATABASE_URL=mysql://root:password@localhost:3306/buyhere

# ─── JWT ───
# Générer des valeurs longues et aléatoires :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Cloudinary (images produits / avatars) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Livraison (millimes : 1 DT = 1000) ───
SHIPPING_FEE=7000
FREE_SHIPPING_THRESHOLD=150000

# ─── Paiement en ligne (sandbox) ───
# URL publique de l'API (pour les webhooks) et schéma de retour vers l'app.
PUBLIC_API_URL=http://localhost:4000
APP_RETURN_URL=buyhere://payment-return

# Konnect — https://dashboard.sandbox.konnect.network
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Flouci — https://developers.flouci.com
FLOUCI_API_URL=https://developers.flouci.com/api
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=
