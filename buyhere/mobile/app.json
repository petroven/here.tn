{
  "expo": {
    "name": "BuyHere",
    "slug": "buyhere",
    "scheme": "buyhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.buyhere.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BuyHere utilise vos photos pour votre photo de profil."
      }
    },
    "android": {
      "package": "tn.buyhere.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E1B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#1E1B18",
          "dark": {
            "backgroundColor": "#1E1B18"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C4532C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BuyHere utilise vos photos pour votre photo de profil."
        }
      ]
    ]
  }
}
