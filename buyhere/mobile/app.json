{
  "expo": {
    "name": "BuyHere",
    "slug": "buyhere",
    "scheme": "buyhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.buyhere.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BuyHere utilise vos photos pour vos produits, vos retours et vos preuves de livraison."
      },
      "associatedDomains": [
        "applinks:buyhere.tn",
        "applinks:www.buyhere.tn"
      ]
    },
    "android": {
      "package": "tn.buyhere.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E1B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "buyhere.tn",
              "pathPrefix": "/produits/"
            },
            {
              "scheme": "https",
              "host": "buyhere.tn",
              "pathPrefix": "/boutiques/"
            },
            {
              "scheme": "https",
              "host": "buyhere.tn",
              "pathPrefix": "/commandes"
            },
            {
              "scheme": "https",
              "host": "buyhere.tn",
              "pathPrefix": "/promotion/"
            },
            {
              "scheme": "https",
              "host": "buyhere.tn",
              "pathPrefix": "/coupons/"
            },
            {
              "scheme": "https",
              "host": "www.buyhere.tn",
              "pathPrefix": "/produits/"
            },
            {
              "scheme": "https",
              "host": "www.buyhere.tn",
              "pathPrefix": "/boutiques/"
            },
            {
              "scheme": "https",
              "host": "www.buyhere.tn",
              "pathPrefix": "/commandes"
            },
            {
              "scheme": "https",
              "host": "www.buyhere.tn",
              "pathPrefix": "/promotion/"
            },
            {
              "scheme": "https",
              "host": "www.buyhere.tn",
              "pathPrefix": "/coupons/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#1E1B18",
          "dark": {
            "backgroundColor": "#1E1B18"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C4532C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BuyHere utilise vos photos pour vos produits, vos retours et vos preuves de livraison.",
          "cameraPermission": "BuyHere utilise l’appareil photo pour vos produits et vos preuves de livraison."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BuyHere utilise votre position pendant votre service de livreur pour vous proposer les courses proches."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}
